rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
             (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 512)) &&
             (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 128)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 256)) &&
             (!('status' in data) || (data.status in ['ONLINE', 'IDLE', 'DND', 'OFFLINE']));
    }

    function isValidServer(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 64 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             (!('description' in data) || (data.description is string && data.description.size() <= 256)) &&
             (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 512));
    }

    // Connectivity test document
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
    }

    // Servers collection
    match /servers/{serverId} {
      allow get: if isSignedIn() && isValidId(serverId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(serverId) && incoming().ownerId == request.auth.uid && isValidServer(incoming());
      allow update: if isSignedIn() && isValidId(serverId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId && isValidServer(incoming());
      allow delete: if isSignedIn() && isValidId(serverId) && existing().ownerId == request.auth.uid;
    }
  }
}
